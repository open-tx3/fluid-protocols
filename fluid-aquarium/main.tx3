// Fluid Aquarium — Babel Fees & Scheduled Transactions on Cardano
// https://github.com/FluidTokens/ft-cardano-aquarium-sc
//
// Users create "tanks" (UTxOs with ADA) that can be consumed by:
//   - Babel fee bots: pay user's tx fees, receive native tokens in return
//   - Aquarium nodes: execute scheduled transactions at a future time
//
// All contracts are PlutusV3 (Aiken v1.1.9).

// --- Parties ---

/// The user creating/managing a tank.
party User;

// On-chain: addr1z... (script payment + user staking credential)
/// Tank spend validator address that holds tank UTxOs.
party TankUserAddr;

/// Tank validator at an enterprise address (no staking cred) used for the ref script.
party TankScript;

/// Oracle reward (stake) address used for withdrawal-based oracle validation.
party OracleScript;

/// Rewards treasury address that receives batcher rewards.
party RewardsAddr;

/// Batcher / Aquarium node operator that executes scheduled txs and babel fees.
party Batcher;

// --- Environment ---

env {
    /// UTxO carrying the tank contract reference script.
    tank_ref: UtxoRef,

    /// Parameters contract NFT UTxO used as a reference input.
    params_ref: UtxoRef,

    /// Oracle contract script hash for withdrawal-based oracle validation.
    oracle_script_hash: Bytes,

    /// FLDT token policy id (CIP-68 user token).
    fldt_policy: Bytes,
    /// FLDT token asset name (CIP-68 user token).
    fldt_name: Bytes,

    /// Staker contract script hash for node staking.
    staker_policy: Bytes,

    /// Parameters contract script hash for NFT identification.
    params_policy: Bytes,
    /// Parameters NFT asset name used to identify the params UTxO.
    params_nft_name: Bytes,

    /// Oracle price feed reference UTxO (stable deployment artifact).
    oracle_feed_ref: UtxoRef,
    /// Oracle contract reference UTxO (stable deployment artifact).
    oracle_contract_ref: UtxoRef,
}

// --- Types ---

// --- Plutus Address types (on-chain representation) ---
// Used by: TankDatum (tank_owner, destination), ScheduledTx redeemer (batcher),
// StakerRedeemer (owner, signer_bot). Built inline via `fn owner_address`.

// Credential — payment or staking credential
// On-chain: VerificationKey(hash) = Constr(0, [ByteArray])
//           Script(hash)          = Constr(1, [ByteArray])
type Credential {
    VerifKey {
        hash: Bytes,
    },
    ScriptCred {
        hash: Bytes,
    },
}

// Optional staking credential wrapper
// On-chain: None = Constr(1, [])
//           Some(Inline(credential)) = Constr(0, [Constr(0, [credential])])
type MaybeStakeCred {
    SomeStake {
        inline: InlineStake,
    },
    NoStake,
}

type InlineStake {
    cred: Credential,
}

// Plutus Address — on-chain Address representation
// On-chain: Constr(0, [payment_credential, stake_credential])
type PlutusAddress {
    payment: Credential,
    stake: MaybeStakeCred,
}

// --- Protocol Types ---

// CardanoToken — describes a token accepted for babel fees or scheduled amount
type CardanoToken {
    policy: Bytes,
    name: Bytes,
    amount: Int,
    divider: Int,
    oracle: MaybeAsset,
}

// Optional oracle asset pointer
type MaybeAsset {
    SomeAsset {
        asset: OracleAsset,
    },
    NoAsset,
}

// Oracle NFT identifier
type OracleAsset {
    policy: Bytes,
    name: Bytes,
}

// Tank datum — on-chain data for each tank UTxO
type TankDatum {
    allowed_tokens: List<CardanoToken>,
    tank_owner: PlutusAddress,
    whitelisted: List<PlutusAddress>,
    execution_time: Int,
    destination: PlutusAddress,
    scheduled_amount: CardanoToken,
    reward: CardanoToken,
}

// DatumParameters — config stored at the parameters contract
type ParamsDatum {
    min_to_stake: Int,
    owner: Bytes,
    address_rewards: PlutusAddress,
    min_ada: Int,
}

// --- Redeemers ---

// Tank redeemer — constructor order matches on-chain
type TankRedeemer {
    Consume {
        paying_token_idx: Int,
        input_tank_idx: Int,
        receivers: Int,
        ref_params_idx: Int,
        whitelist_idx: Int,
    },
    ConsumeAll {
        paying_token_idx: Int,
        input_tank_idx: Int,
        receivers: Int,
        ref_params_idx: Int,
        whitelist_idx: Int,
    },
    WithdrawTank,
    ScheduledTx {
        input_tank_idx: Int,
        batcher: PlutusAddress,      // batcher's reward address
        ref_staking_idx: Int,
        ref_params_idx: Int,
        whitelist_idx: Int,
    },
    ConsumeOracle {
        paying_token_idx: Int,
        input_tank_idx: Int,
        receivers: Int,
        oracle_idx: Int,
        ref_params_idx: Int,
        whitelist_idx: Int,
    },
    ConsumeAllOracle {
        paying_token_idx: Int,
        input_tank_idx: Int,
        receivers: Int,
        oracle_idx: Int,
        ref_params_idx: Int,
        whitelist_idx: Int,
    },
}

// Staker mint redeemer
type StakerRedeemer {
    owner: PlutusAddress,            // owner wallet
    signer_bot: PlutusAddress,       // bot wallet (stake hash == staker NFT name)
    ref_index: Int,
    output_staking: Int,
    staking_inputs: Int,
}

// --- Oracle Types (for withdrawal-based price validation) ---

// Asset identifier (policyId + assetName)
type FeedAsset {
    policy: Bytes,
    name: Bytes,
}

// Common data shared by all oracle price feed types
type CommonFeedData {
    valid_from: Int,
    valid_to: Int,
    token: FeedAsset,
}

// Oracle price feed — variant type matching on-chain constructor order
// On-chain: Aggregated=0, Pooled=1, Dedicated=2, PriceDataCharlie=3, PriceDataOrcfax=4
type OraclePriceFeed {
    FeedAggregated {
        common: CommonFeedData,
        price: Int,
        denominator: Int,
    },
    FeedPooled {
        common: CommonFeedData,
        token_a: Int,
        token_b: Int,
    },
    FeedDedicated {
        common: CommonFeedData,
        price: Int,
        denominator: Int,
    },
    FeedCharlie {
        provider_idx: Int,
        common: CommonFeedData,
        price: Int,
        denominator: Int,
    },
    FeedOrcfax {
        pointer_idx: Int,
        provider_idx: Int,
        common: CommonFeedData,
        price: Int,
        denominator: Int,
    },
}

// Oracle signature (ed25519 signature + key position index)
type OracleSignature {
    signature: Bytes,
    key_position: Int,
}

// Oracle redeemer — wraps the price feed + signatures.
// `signatures` is empty for PriceDataCharlie (oracle validated via ref input)
// but populated for the signature-bearing feed variants (Aggregated/Pooled/Dedicated).
type OracleRedeemer {
    feed: OraclePriceFeed,
    signatures: List<OracleSignature>,
}

// --- Functions ---

// Build a wallet's on-chain plutus address (key-hash payment + inline key-hash
// stake) from plain hash params. Shared by the tank datum, scheduled-tx redeemer
// and staker redeemer, which all construct the same shape:
//   Constr(0, [ Constr(0,[pkh]), Constr(0,[Constr(0,[Constr(0,[stake])])]) ])
fn owner_address(pkh: Bytes, stake_key: Bytes) -> PlutusAddress {
    PlutusAddress {
        payment: Credential::VerifKey {
            hash: pkh,
        },
        stake: MaybeStakeCred::SomeStake {
            inline: InlineStake {
                cred: Credential::VerifKey {
                    hash: stake_key,
                },
            },
        },
    }
}

// ============================================================
// 1. CREATE BABEL FEE TANK
// ============================================================
// User sends ADA to a tank script address with a babel fee datum.
// No script execution required — simple wallet tx.
//
// The datum encodes which tokens the tank owner accepts as payment
// and the exchange rate (or oracle reference).

/// Create a babel-fee tank by locking ADA at the tank script with an accepted-tokens datum.
tx create_babel_tank(
    /// ADA (lovelace) to deposit into the new tank.
    tank_ada: Int,
    /// Tank owner's payment key hash (28 bytes).
    owner_payment_hash: Bytes,
    /// Tank owner's stake key hash (28 bytes).
    owner_stake_hash: Bytes,
) {
    input payment {
        from: User,
        min_amount: Ada(tank_ada) + fees,
    }

    output tank {
        to: TankUserAddr,
        amount: Ada(tank_ada),
        datum: TankDatum {
            allowed_tokens: [],
            tank_owner: owner_address(owner_payment_hash, owner_stake_hash),
            whitelisted: [],
            execution_time: 0,
            destination: owner_address(owner_payment_hash, owner_stake_hash),
            scheduled_amount: CardanoToken {
                policy: "",
                name: "",
                amount: 0,
                divider: 1000000,
                oracle: MaybeAsset::NoAsset {},
            },
            reward: CardanoToken {
                policy: "",
                name: "",
                amount: 0,
                divider: 1000000,
                oracle: MaybeAsset::NoAsset {},
            },
        },
    }

    output change {
        to: User,
        amount: payment - Ada(tank_ada) - fees,
    }
}

// ============================================================
// 2. CREATE SCHEDULED TRANSACTION TANK
// ============================================================
// User sends ADA to a tank with a scheduled transaction datum.
// The datum specifies: destination, amount, reward, and execution time.
// No script execution required — simple deposit.

/// Create a scheduled-transaction tank that will pay a destination after a future execution time.
tx create_scheduled_tank(
    /// ADA (lovelace) to deposit into the new tank.
    tank_ada: Int,
    /// Tank owner's payment key hash (28 bytes).
    owner_payment_hash: Bytes,
    /// Tank owner's stake key hash (28 bytes).
    owner_stake_hash: Bytes,
    /// POSIX-time slot at which the scheduled tx becomes executable.
    execution_time: Int,
    /// ADA (lovelace) to send to the destination when executed.
    scheduled_ada: Int,
    /// ADA (lovelace) reward paid to the batcher that executes the tx.
    reward_ada: Int,
) {
    input payment {
        from: User,
        min_amount: Ada(tank_ada) + fees,
    }

    output tank {
        to: TankUserAddr,
        amount: Ada(tank_ada),
        datum: TankDatum {
            allowed_tokens: [],
            tank_owner: owner_address(owner_payment_hash, owner_stake_hash),
            whitelisted: [],
            execution_time: execution_time,
            destination: owner_address(owner_payment_hash, owner_stake_hash),
            scheduled_amount: CardanoToken {
                policy: "",
                name: "",
                amount: scheduled_ada,
                divider: 1000000,
                oracle: MaybeAsset::NoAsset {},
            },
            reward: CardanoToken {
                policy: "",
                name: "",
                amount: reward_ada,
                divider: 1000000,
                oracle: MaybeAsset::NoAsset {},
            },
        },
    }

    output change {
        to: User,
        amount: payment - Ada(tank_ada) - fees,
    }
}

// ============================================================
// 3. WITHDRAW FROM TANK
// ============================================================
// Tank owner reclaims ADA from their tank.
// Requires spending from an address where the tank owner's wallet
// is present in the inputs (must_be_signed_by_user_contract).

/// Withdraw the full balance of a tank back to its owner.
tx withdraw_tank(
    /// UTxO reference of the tank to withdraw.
    tank_utxo: UtxoRef,
) {
    reference tank_script {
        ref: tank_ref,
    }

    reference params_data {
        ref: params_ref,
    }

    input tank {
        ref: tank_utxo,
        redeemer: TankRedeemer::WithdrawTank {},
    }

    // Tank owner must have an input to prove ownership
    input owner_proof {
        from: User,
        min_amount: Ada(5000000) + fees,
    }

    output change {
        to: User,
        amount: tank + owner_proof - fees,
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        User,
    }
}

// ============================================================
// 4. CONSUME ORACLE (Babel Fee with Oracle Price)
// ============================================================
// A batcher consumes part of a tank's ADA to pay a user's tx fees.
// The tank owner receives native tokens at oracle-determined rate.
//
// Reference inputs (sorted by tx_hash#idx):
//   - Oracle provider data (e.g. Charli3)
//   - Oracle contract ref
//   - Staker ref (optional)
//   - Parameters NFT
//   - Tank ref script
//
// The oracle is validated via a withdrawal with 0 ADA.

/// Consume a babel-fee tank using an oracle price feed to pay the user's fees in tokens.
tx consume_oracle(
    /// UTxO reference of the tank being consumed.
    tank_utxo: UtxoRef,
    /// UTxO reference of the oracle provider data (e.g. Charli3).
    oracle_provider_ref: UtxoRef,
    /// Index of the paying token within the tank's allowed_tokens list.
    paying_token_idx: Int,
    /// Index of the tank input within tx inputs (sorted).
    input_tank_idx: Int,
    /// Index of the oracle reference input within reference inputs (sorted).
    oracle_idx: Int,
    /// Index of the params reference input within reference inputs (sorted).
    ref_params_idx: Int,
    /// ADA (lovelace) returned to the tank UTxO.
    tank_return_ada: Int,
    /// ADA (lovelace) paid alongside tokens to the tank owner.
    payment_ada: Int,
    /// Policy id of the token used to pay the tank owner.
    payment_token_policy: Bytes,
    /// Asset name of the token used to pay the tank owner.
    payment_token_name: Bytes,
    /// Quantity of the payment token delivered to the tank owner.
    payment_token_qty: Int,
    /// ADA (lovelace) delivered to the user's destination output.
    dest_ada: Int,
    // Oracle redeemer params (PriceDataCharlie)
    /// Charli3 oracle provider index within the price feed.
    oracle_provider_idx: Int,
    /// Lower bound (slot) of the oracle price validity window.
    oracle_valid_from: Int,
    /// Upper bound (slot) of the oracle price validity window.
    oracle_valid_to: Int,
    /// Oracle-quoted price numerator.
    oracle_price: Int,
    /// Oracle-quoted price denominator.
    oracle_denominator: Int,
    /// ed25519 oracle signatures — empty for Charli3 (validated via ref input),
    /// populated for signature-bearing feed variants.
    signatures: List<OracleSignature>,
) {
    locals {
        payment_token: AnyAsset(payment_token_policy, payment_token_name, payment_token_qty),
    }

    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 300,
    }

    reference tank_script {
        ref: tank_ref,
    }

    reference params_data {
        ref: params_ref,
    }

    reference oracle_feed {
        ref: oracle_feed_ref,
    }

    reference oracle_provider {
        ref: oracle_provider_ref,
    }

    reference oracle_contract {
        ref: oracle_contract_ref,
    }

    // Consume the tank UTxO
    input tank {
        ref: tank_utxo,
        redeemer: TankRedeemer::ConsumeOracle {
            paying_token_idx: paying_token_idx,
            input_tank_idx: input_tank_idx,
            receivers: 0,
            oracle_idx: oracle_idx,
            ref_params_idx: ref_params_idx,
            whitelist_idx: 0,
        },
    }

    // User wallet input (provides tokens for payment + collateral)
    input payment {
        from: User,
        min_amount: Ada(dest_ada) + payment_token + fees,
    }

    // Return remaining ADA to the tank (same address, same datum)
    output tank_return {
        to: TankUserAddr,
        amount: Ada(tank_return_ada),
        datum: tank,
    }

    // Payment to tank owner (tokens at oracle rate)
    output owner_payment {
        to: User,
        amount: Ada(payment_ada) + payment_token,
    }

    // User destination output (the actual tx the user wanted)
    output destination {
        to: User,
        amount: Ada(dest_ada),
    }

    // User change
    output change {
        to: User,
        amount: payment - Ada(dest_ada) - payment_token - fees,
    }

    // Oracle validation via withdrawal (0 ADA)
    cardano::withdrawal {
        from: OracleScript,
        amount: 0,
        redeemer: OracleRedeemer {
            feed: OraclePriceFeed::FeedCharlie {
                provider_idx: oracle_provider_idx,
                common: CommonFeedData {
                    valid_from: oracle_valid_from,
                    valid_to: oracle_valid_to,
                    // Oracle token must match payment token (enforced by
                    // is_feed_token_correct in validators/oracle.ak)
                    token: FeedAsset {
                        policy: payment_token_policy,
                        name: payment_token_name,
                    },
                },
                price: oracle_price,
                denominator: oracle_denominator,
            },
            signatures: signatures,
        },
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        User,
    }
}

// ============================================================
// 5. EXECUTE SCHEDULED TRANSACTION
// ============================================================
// An Aquarium node (batcher) executes a scheduled tx when
// the execution time has passed.
//
// Outputs:
//   #0: Scheduled amount to destination
//   #1: Reward to treasury
//   #2: Change to batcher

// NOTE: On-chain scheduled txs are ADA-only in both dest and reward.
// For token-bearing scheduled txs, a separate variant would be needed.
/// Execute a scheduled tank, paying the destination and collecting the batcher reward.
tx execute_scheduled(
    /// UTxO reference of the scheduled tank to execute.
    tank_utxo: UtxoRef,
    /// UTxO reference of the batcher's staker registration.
    staker_ref: UtxoRef,
    /// Batcher's payment key hash (28 bytes); built inline into the redeemer's batcher address.
    batcher_payment_hash: Bytes,
    /// Batcher's stake key hash (28 bytes); built inline into the redeemer's batcher address.
    batcher_stake_hash: Bytes,
    /// Batcher's signer key hash required on the tx.
    batcher_signer_hash: Bytes,
    /// Index of the staker ref input within reference inputs (sorted).
    ref_staking_idx: Int,
    /// Index of the params ref input within reference inputs (sorted).
    ref_params_idx: Int,
    /// ADA (lovelace) delivered to the scheduled destination.
    dest_ada: Int,
    /// ADA (lovelace) reward paid to the batcher / rewards treasury.
    reward_ada: Int,
) {
    validity {
        since_slot: tip_slot(),
        until_slot: tip_slot() + 300,
    }

    reference tank_script {
        ref: tank_ref,
    }

    reference params_data {
        ref: params_ref,
    }

    reference staker_data {
        ref: staker_ref,
    }

    // Consume the scheduled tank UTxO
    input tank {
        ref: tank_utxo,
        redeemer: TankRedeemer::ScheduledTx {
            input_tank_idx: 0,
            batcher: owner_address(batcher_payment_hash, batcher_stake_hash),
            ref_staking_idx: ref_staking_idx,
            ref_params_idx: ref_params_idx,
            whitelist_idx: 0,
        },
    }

    // Batcher wallet (covers fees)
    input batcher {
        from: Batcher,
        min_amount: Ada(5000000) + fees,
    }

    // Scheduled payment to destination
    output destination {
        to: User,
        amount: Ada(dest_ada),
    }

    // Reward to treasury
    output reward {
        to: RewardsAddr,
        amount: Ada(reward_ada),
    }

    // Batcher change
    output change {
        to: Batcher,
        amount: batcher - fees,
    }

    collateral {
        from: Batcher,
        min_amount: Ada(5000000),
    }

    signers {
        batcher_signer_hash,
    }
}

// ============================================================
// 6. STAKE FLDT (Become Aquarium Node)
// ============================================================
// User stakes FLDT tokens to register as an Aquarium node.
// Mints a staker NFT with the bot's stake key hash as asset name.

/// Stake FLDT and mint the staker NFT that registers the caller as an Aquarium node.
tx stake_fldt(
    /// Quantity of FLDT tokens to stake.
    stake_amount: Int,
    /// Staker NFT asset name (typically the bot's stake key hash).
    staker_nft_name: Bytes,
    /// Staker/tank owner's payment key hash (28 bytes).
    owner_payment_hash: Bytes,
    /// Staker/tank owner's stake key hash (28 bytes).
    owner_stake_hash: Bytes,
    /// Signer-bot wallet's payment key hash (28 bytes).
    signer_bot_payment_hash: Bytes,
    /// Signer-bot wallet's stake key hash (28 bytes); equals the staker NFT asset name.
    signer_bot_stake_hash: Bytes,
    /// Index of the staker reference input within reference inputs (sorted).
    ref_index: Int,
    /// Index of the staking output within tx outputs.
    output_staking: Int,
    /// Number of staking inputs in the tx.
    staking_inputs: Int,
    /// Required signer key hash on the tx.
    signer_hash: Bytes,
) {
    locals {
        fldt_tokens: AnyAsset(fldt_policy, fldt_name, stake_amount),
        staker_nft: AnyAsset(staker_policy, staker_nft_name, 1),
    }

    reference params_data {
        ref: params_ref,
    }

    input payment {
        from: User,
        min_amount: Ada(2000000) + fldt_tokens + fees,
    }

    // Staker output: FLDT + staker NFT at staker contract address
    output stake {
        to: TankUserAddr,
        amount: Ada(1456780) + fldt_tokens + staker_nft,
    }

    // User change
    output change {
        to: User,
        amount: payment - Ada(1456780) - fldt_tokens - staker_nft - fees,
    }

    // Mint the staker NFT
    mint {
        amount: staker_nft,
        redeemer: StakerRedeemer {
            owner: owner_address(owner_payment_hash, owner_stake_hash),
            signer_bot: owner_address(signer_bot_payment_hash, signer_bot_stake_hash),
            ref_index: ref_index,
            output_staking: output_staking,
            staking_inputs: staking_inputs,
        },
    }

    collateral {
        from: User,
        min_amount: Ada(5000000),
    }

    signers {
        signer_hash,
    }
}
